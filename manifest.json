{
  "name": "MDpad",
  "short_name": "MDpad",
  "description": "Markdown reader and editor — a Hawkins-Digital utility",
  "start_url": "./mdpad.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#efefef",
  "theme_color": "#ffb900",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    {
      "action": "./mdpad.html",
      "accept": {
        "text/markdown": [".md", ".markdown", ".mdown"],
        "text/plain": [".txt"]
      }
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
